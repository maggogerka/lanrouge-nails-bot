# Copy to .env.demo. Never reuse production credentials or a production database.
APP_MODE=demo
APP_ENV=production
BOT_TOKEN=REPLACE_WITH_A_SEPARATE_BOTFATHER_DEMO_TOKEN
DATABASE_URL=postgresql+asyncpg://crm_demo@postgres:5432/crm_public_demo
REDIS_URL=redis://:placeholder@redis:6379/0
TIMEZONE=Europe/Moscow
INSTANCE_ID=public-demo
REDIS_NAMESPACE=crm_public_demo
LOG_LEVEL=INFO

# SHA-256 values of production secrets. The demo refuses an exact match.
# Generate locally; never place the production token or URL in this file.
PRODUCTION_BOT_TOKEN_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
PRODUCTION_DATABASE_URL_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

DEMO_SITE_URL=https://example.invalid/
DEMO_SESSION_TTL_HOURS=2
DEMO_DATA_RETENTION_HOURS=24
DEMO_RESET_COOLDOWN_SECONDS=60
DEMO_RATE_LIMIT_PER_MINUTE=30

ADMIN_TELEGRAM_IDS=
SENTRY_DSN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
MINI_APP_ALLOWED_ORIGINS=
