# Public demo uses a separate BotFather token mounted from a Docker secret.
APP_MODE=demo
APP_ENV=production
BOT_TOKEN=
DATABASE_URL=
REDIS_URL=redis://:placeholder@redis:6379/0
TIMEZONE=Europe/Moscow
INSTANCE_ID=public-demo
REDIS_NAMESPACE=crm_public_demo
LOG_LEVEL=INFO

# SHA-256 of the production BOT_TOKEN. The demo refuses an exact token match.
PRODUCTION_BOT_TOKEN_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

DEMO_SITE_URL=https://example.invalid/
DEMO_SESSION_TTL_HOURS=2
DEMO_RATE_LIMIT_PER_MINUTE=30
DEMO_GLOBAL_RATE_LIMIT_PER_MINUTE=600

# Production integrations are forbidden in demo mode.
ADMIN_TELEGRAM_IDS=
SENTRY_DSN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
MINI_APP_ALLOWED_ORIGINS=
