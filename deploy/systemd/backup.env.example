# Install as /etc/telegram-crm/backup.env with mode 0600 and root ownership.
# Values are host paths/identifiers, not the secret contents themselves.
COMPOSE_PROJECT_NAME=telegram-crm-production
ENV_FILE=/opt/telegram-crm-bot/.env
POSTGRES_PASSWORD_SECRET_FILE=/etc/telegram-crm/secrets/postgres_password
RESTIC_PASSWORD_SECRET_FILE=/etc/telegram-crm/secrets/restic_password
