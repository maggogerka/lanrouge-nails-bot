[Unit]
Description=Check freshness of lanrouge nails PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lanrouge-nails-bot
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f compose.production.yml -f compose.profiles.yml --profile backup run --rm backup python -m app.maintenance.backup_restore check-freshness
TimeoutStartSec=30m

[Install]
WantedBy=multi-user.target
