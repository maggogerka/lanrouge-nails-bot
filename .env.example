# Telegram
BOT_TOKEN=
# Prefer the file variant in production; never set both forms.
BOT_TOKEN_FILE=
# Numeric IDs from /whoami, comma-separated. Restart/recreate bot after changes.
ADMIN_TELEGRAM_IDS=
PRIVACY_POLICY_URL=

# Application
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
INSTANCE_ID=example-instance
REDIS_NAMESPACE=example_instance
SENTRY_DSN=
SENTRY_DSN_FILE=

# CRM vendor support for OWNER/MANAGER/MASTER (separate from salon client support).
VENDOR_SUPPORT_URL=
VENDOR_SUPPORT_NAME=Техническая поддержка CRM
VENDOR_SUPPORT_HOURS=
VENDOR_SUPPORT_INSTRUCTIONS=
REMINDER_POLL_INTERVAL_SECONDS=15
REMINDER_BATCH_SIZE=20
REMINDER_MAX_ATTEMPTS=5
REMINDER_LEASE_SECONDS=120
REFERENCE_COMPLETED_RETENTION_DAYS=30
REFERENCE_CANCELLED_RETENTION_DAYS=7
REFERENCE_NO_SHOW_RETENTION_DAYS=14
REFERENCE_DRAFT_RETENTION_HOURS=24
REFERENCE_CLEANUP_INTERVAL_HOURS=6

# Mini App API. Use exact public values; wildcards and HTTP origins are rejected.
API_HOST=0.0.0.0
API_PORT=8080
API_ALLOWED_HOSTS=bot.example.com
MINI_APP_ALLOWED_ORIGINS=https://bot.example.com
API_ENFORCE_HTTPS=true
API_MAX_BODY_BYTES=65536
API_READINESS_TIMEOUT_SECONDS=3
TELEGRAM_INIT_DATA_TTL_SECONDS=300
API_SESSION_TTL_SECONDS=900
# Generate two independent random values of at least 32 bytes; never commit them.
API_RATE_LIMIT_SUBJECT_KEY=
API_SESSION_SIGNING_KEY=
API_RATE_LIMIT_SUBJECT_KEY_FILE=
API_SESSION_SIGNING_KEY_FILE=

# YooKassa is optional and remains disabled in DB until credentials are configured.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SHOP_ID_FILE=
YOOKASSA_SECRET_KEY_FILE=
YOOKASSA_BUSINESS_ID=1
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_RETENTION_DAYS=30

# Application connections inside Docker Compose
DATABASE_URL=postgresql+asyncpg://lanrouge:replace-with-postgres-secret@postgres:5432/lanrouge
REDIS_URL=redis://:replace-with-redis-secret@redis:6379/0
DATABASE_URL_FILE=
REDIS_URL_FILE=

# Secret files are mounted by Compose. The value embedded in each URL above must
# exactly match its file (use URL-safe random strings to avoid percent-encoding).
POSTGRES_USER=lanrouge
POSTGRES_DB=lanrouge
POSTGRES_PASSWORD_SECRET_FILE=.secrets/postgres_password
REDIS_PASSWORD_SECRET_FILE=.secrets/redis_password

# Encrypted off-site backup (optional; BACKUP_ENABLED=false is explicit disabled mode).
BACKUP_ENABLED=false
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
RESTIC_PASSWORD_SECRET_FILE=.secrets/restic_password
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
BACKUP_COMMAND_TIMEOUT_SECONDS=1800
RESTORE_DATABASE_URL=
RESTORE_ACKNOWLEDGE=
