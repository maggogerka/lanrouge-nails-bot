# Telegram
BOT_TOKEN=
# Numeric IDs from /whoami, comma-separated. Restart/recreate bot after changes.
ADMIN_TELEGRAM_IDS=
PRIVACY_POLICY_URL=

# Application
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
SENTRY_DSN=
REMINDER_POLL_INTERVAL_SECONDS=15
REMINDER_BATCH_SIZE=20
REMINDER_MAX_ATTEMPTS=5
REMINDER_LEASE_SECONDS=120

# Application connections inside Docker Compose
DATABASE_URL=postgresql+asyncpg://lanrouge:change-me@postgres:5432/lanrouge
REDIS_URL=redis://redis:6379/0

# Local PostgreSQL container only. Replace both occurrences of change-me:
# POSTGRES_PASSWORD and the password embedded in DATABASE_URL must match.
POSTGRES_USER=lanrouge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lanrouge
